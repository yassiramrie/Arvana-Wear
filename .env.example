# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template konfigurasi lingkungan
# ─────────────────────────────────────────────────────────────────────────────
# PETUNJUK:
#   cp .env.example .env
#   Lalu isi nilainya sesuai resource AWS kamu.
#
# PENTING: File .env SUDAH ada di .gitignore. JANGAN di-commit ke Git!
# ─────────────────────────────────────────────────────────────────────────────

# Aplikasi
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost
JWT_SECRET=ubah_ini_pake_password_acak

# Database (AWS RDS PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arvana_wear
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_database_acak
