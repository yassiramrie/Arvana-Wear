# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Template environment untuk Docker setup
# ─────────────────────────────────────────────────────────────────────────────
# PETUNJUK:
#   cp .env.docker .env
#   Lalu isi nilainya sesuai kebutuhan.
#
# Di production (EC2), file ini ditulis otomatis oleh CI/CD dari GitHub Secrets.
# Locally, cukup copy dan ubah password-nya.
#
# Variables yang dipakai docker-compose.yml:
#   ${DB_PASSWORD}                → POSTGRES_PASSWORD (postgres) + DB_PASSWORD (app)
#   ${GRAFANA_PASSWORD}           → Grafana admin password
# ─────────────────────────────────────────────────────────────────────────────

# ⚠️ Ganti password di bawah sebelum digunakan — jangan pake default!
# Password PostgreSQL — dipakai oleh container postgres DAN app
DB_PASSWORD=ganti_dengan_password_database_acak

# Password Grafana admin — akses http://localhost:3001
GRAFANA_PASSWORD=ganti_dengan_password_grafana_acak

# JWT secret — string acak untuk menandatangani token login
JWT_SECRET=ganti_dengan_secret_jwt_acak_minimal_32_karakter

# Aplikasi lokal Docker Compose
NODE_ENV=development
CORS_ORIGIN=http://localhost
DB_SSL=false
DB_POOL_MAX=10
